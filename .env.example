# ================================================================
# AGY2API Environment Variables Configuration Example
# Copy this file to .env and adjust values as needed
# ================================================================

# ================================================================
# Server Configuration
# ================================================================

# Server listening address
# Default: 0.0.0.0 (listen on all network interfaces)
HOST=0.0.0.0

# Server port
# Default: 7861
PORT=7861

# Path prefix to strip when behind reverse proxy (e.g. /AGY2API)
# Only configure if reverse proxy forwards /AGY2API/xxx as-is; leave empty if proxy already strips prefix
# Default: empty (no stripping)
PATH_PREFIX=

# ================================================================
# Password Configuration (Separated Passwords)
# ================================================================

# Chat API password (used for OpenAI/Gemini/Claude API endpoints)
# Default: pwd
API_PASSWORD=your_api_password

# Control panel access password (used for Web interface login)
# Default: pwd
PANEL_PASSWORD=your_panel_password

# IP Whitelist (Optional)
# Enable toggle + comma or newline separated whitelist entries
# Each entry supports: single IP / CIDR subnet / start-end range (- or ~ separated), IPv4/IPv6
# When enabled, only whitelisted IPs can access panel and API; other IPs return 403
# Default: false (unrestricted)
IP_WHITELIST_ENABLED=false
IP_WHITELIST=

# Model Name Rewrite (Optional)
# When enabled, matches requested model name against regex patterns and rewrites on match
# Format: JSON array of [pattern, replacement]; also supports comma-separated "pattern->replacement"
# Replacement supports regex backreferences (e.g. \1)
# Default: false
MODEL_REWRITE_ENABLED=false
MODEL_REWRITE_RULES=[["^gpt-4$","gemini-2.5-pro"],["^claude-3-5-sonnet.*$","claude-sonnet-4-5"]]

# ================================================================
# Storage Configuration
# ================================================================

# Storage backend priority: PostgreSQL > Local SQLite file storage
# The system automatically selects the highest priority available backend

# PostgreSQL distributed storage mode (highest priority)
# Setting POSTGRESQL_URI automatically enables PostgreSQL mode
# Format: postgresql://user:password@localhost:5432/agy2api
# Default: empty (uses local SQLite creds/credentials.db)
POSTGRESQL_URI=

# ================================================================
# Google API Configuration
# ================================================================

# Credentials directory (used in local storage mode)
# Default: ./creds
CREDENTIALS_DIR=./creds

# Proxy configuration (Optional)
# Supports http, https, socks5, socks5h proxies
# Format: http://proxy:port, https://proxy:port, socks5://proxy:port
PROXY=http://localhost:7890

# Google API Proxy URL Configuration (Optional)

# Google OAuth2 endpoint
# Default: https://oauth2.googleapis.com
OAUTH_PROXY_URL=https://oauth2.googleapis.com

# Proxy URL for Google APIs invocations
# Default: https://www.googleapis.com
GOOGLEAPIS_PROXY_URL=https://www.googleapis.com

# URL for Google Antigravity API
# Default: https://daily-cloudcode-pa.googleapis.com
ANTIGRAVITY_API_URL=https://daily-cloudcode-pa.googleapis.com

# ================================================================
# Error Handling and Retry Configuration
# ================================================================

# Enable auto-ban feature
# Automatically disable a credential when it returns specific error codes
# Default: false
AUTO_BAN=false

# Auto-ban error code list (comma-separated)
# Default: 403
AUTO_BAN_ERROR_CODES=403

# Enable 429 rate limit retry
# Default: true
RETRY_429_ENABLED=true

# Maximum retry attempts for 429 errors
# Default: 5
RETRY_429_MAX_RETRIES=5

# 429 error retry interval (seconds)
# Default: 1
RETRY_429_INTERVAL=1

# ================================================================
# Logging Configuration
# ================================================================

# Log level
# Options: debug, info, warning, error, critical
# Default: info
LOG_LEVEL=info

# Complete silence: suppress all console logging
# Default: 1 (logging enabled)
ENABLE_LOG=1

# ================================================================
# Advanced Feature Configuration
# ================================================================

# Maximum continuation attempts for anti-truncation models
# Used for "autostitch-" prefixed models
# Default: 3
ANTI_TRUNCATION_MAX_ATTEMPTS=3

# ================================================================
# Environment Variables Guide
# ================================================================

# 1. Storage Mode:
#    - PostgreSQL mode (highest priority): Set POSTGRESQL_URI
#    - SQLite local mode (default): Leave POSTGRESQL_URI empty; data stored in creds/credentials.db

# 2. Passwords:
#    API_PASSWORD (chat API) and PANEL_PASSWORD (control panel) are independently configured; default is pwd

# 3. Precedence:
#    Environment variables > Database config > Default values

# 4. Booleans:
#    true/1/yes/on = enabled
#    false/0/no/off = disabled
